<?xml version="1.0" encoding="utf-8"?>
<!--
  SILMAY (RNF-05): ningún dato local sale del dispositivo por respaldo ni migración.
  En Android 12+ (targetSdk >= 31) android:allowBackup="false" solo desactiva el respaldo
  en la nube; la transferencia dispositivo a dispositivo debe excluirse explícitamente aquí.
  Protege la caché persistente de Firestore (registros offline) y la sesión de Firebase Auth.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
