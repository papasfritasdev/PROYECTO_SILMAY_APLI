{
  "name": "silmay-web",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma web administrativa del Sistema SILMAY (React 18 + Vite + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:integration": "npm --prefix ../firebase/functions run build && firebase emulators:exec --only auth,firestore,functions --project silmay-dev \"vitest run -c vitest.integration.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "typescript": "~5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
