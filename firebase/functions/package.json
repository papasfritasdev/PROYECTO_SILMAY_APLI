{
  "name": "silmay-functions",
  "version": "1.0.0",
  "description": "Backend Serverless y Cloud Functions para Sistema SILMAY",
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run --passWithNoTests",
    "test:rules": "firebase emulators:exec --only firestore --project silmay-dev \"vitest run -c vitest.rules.config.ts\""
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.17.0",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "private": true
}
